{
  "name": "spp-lang-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b packages/playwright/tsconfig.build.json packages/storybook/tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "pnpm --filter './packages/*' test && node --test 'test/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:storybook": "pnpm --recursive test:storybook",
    "demo": "pnpm --filter example-demo start",
    "docs": "pnpm --filter site start",
    "docs:build": "pnpm --filter site build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@spp-lang/playwright": "workspace:*",
    "@spp-lang/storybook": "workspace:*",
    "@types/node": "^26.6.3",
    "husky": "^9.1.7",
    "spp-lang": "workspace:*",
    "typescript": "^7.0.2",
    "vscode-jsonrpc": "^9.0.3"
  }
}
