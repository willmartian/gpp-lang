{
  "name": "gpp-lang",
  "version": "0.1.0",
  "description": "Specs that run. Written by agents, read by people.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./lsp": "./src/tools/lsp.ts"
  },
  "bin": {
    "gpp-lang": "./bin/gpp-lang.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./lsp": {
        "types": "./dist/src/tools/lsp.d.ts",
        "default": "./dist/src/tools/lsp.js"
      }
    },
    "bin": {
      "gpp-lang": "./dist/bin/gpp-lang.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "rm -rf dist node_modules/.cache && pnpm run build"
  },
  "keywords": [
    "gherkin",
    "cucumber",
    "bdd",
    "cognate"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willmartian/gpp-lang.git",
    "directory": "packages/gpp-lang"
  },
  "dependencies": {
    "@gpp-lang/core": "workspace:^",
    "commander": "^15.0.0",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  }
}
