{
  "name": "@gpp-lang/testing-library",
  "version": "0.1.0",
  "description": "Gherkin++ as Vitest or Jest tests, with Testing Library.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "node --test 'test/**/*.test.ts'",
    "test:vitest": "vitest run --config test/fixtures/vitest.config.ts",
    "prepack": "rm -rf dist node_modules/.cache && pnpm run build"
  },
  "keywords": [
    "gherkin",
    "bdd",
    "vitest",
    "jest",
    "testing-library",
    "gpp-lang"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willmartian/gpp-lang.git",
    "directory": "packages/testing-library"
  },
  "peerDependencies": {
    "@gpp-lang/core": "^0.1.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/user-event": "^14.0.0"
  },
  "devDependencies": {
    "@gpp-lang/core": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^30.1.3",
    "vitest": "^4.1.12"
  }
}
