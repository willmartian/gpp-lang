{
  "name": "@gpp-lang/playwright",
  "version": "0.1.0",
  "description": "Gherkin++ scenarios, in .gpp files and Markdown, as Playwright tests.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "node --test 'test/**/*.test.ts'",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "gherkin",
    "bdd",
    "playwright",
    "gpp-lang"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willmartian/gpp-lang.git",
    "directory": "packages/playwright"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0",
    "@gpp-lang/core": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@gpp-lang/core": "workspace:*"
  }
}
