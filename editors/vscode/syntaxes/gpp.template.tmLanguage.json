{
  "$comment": "Highlights gpp`…` templates in JavaScript and TypeScript as Gherkin++, by injecting into their grammars.",
  "scopeName": "inline.gpp.template",
  "injectionSelector": "L:source.js -comment -string, L:source.js.jsx -comment -string, L:source.ts -comment -string, L:source.tsx -comment -string",
  "patterns": [{ "include": "#template" }],
  "repository": {
    "template": {
      "begin": "\\b(gpp)\\s*(`)",
      "end": "(?<!\\\\)`",
      "beginCaptures": {
        "1": { "name": "entity.name.function.tagged-template.js" },
        "2": { "name": "string.template.js punctuation.definition.string.template.begin.js" }
      },
      "endCaptures": {
        "0": { "name": "string.template.js punctuation.definition.string.template.end.js" }
      },
      "contentName": "meta.embedded.block.gpp",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.js" },
        { "match": "\\$\\{[^}]*\\}?", "name": "invalid.illegal.interpolation.gpp" },
        { "include": "source.gpp" }
      ]
    }
  }
}
