{
  "$comment": "Gherkin, with Spec++'s code in steps and Defines: capitalised words, numbers, symbols and strings, as the lexer finds them (cognate.ts). In .spp files and Markdown, the language server's semantic tokens refine it, telling what a Define is given apart from a word. Rules start at a line's start or, in an spp`…` template, just after its backtick, and a step or a table ends at a backtick, which closes a template.",
  "name": "Spec++",
  "scopeName": "source.spp",
  "patterns": [
    { "include": "#comment" },
    { "include": "#docString" },
    { "include": "#structure" },
    { "include": "#tags" },
    { "include": "#table" },
    { "include": "#step" },
    { "include": "#defineBlock" },
    { "include": "#define" },
    { "include": "#string" }
  ],
  "repository": {
    "comment": {
      "match": "(?:^|\\G)\\s*#.*$",
      "name": "comment.line.number-sign.spp"
    },
    "docString": {
      "begin": "(?:^|\\G)\\s*(\"\"\"|```)",
      "end": "^\\s*\\1",
      "name": "string.quoted.docstring.spp"
    },
    "structure": {
      "match": "(?:^|\\G)\\s*(Feature|Background|Scenario Outline|Scenario Template|Scenario|Example|Examples|Scenarios|Rule):(.*)$",
      "captures": {
        "1": { "name": "keyword.control.spp" },
        "2": { "name": "entity.name.section.spp" }
      }
    },
    "tags": {
      "match": "(?<=^|\\s)@\\S+",
      "name": "entity.name.tag.spp"
    },
    "table": {
      "begin": "(?:^|\\G)\\s*\\|",
      "end": "$|(?<!\\\\)(?=`)",
      "beginCaptures": { "0": { "name": "punctuation.separator.table.spp" } },
      "patterns": [{ "match": "\\|", "name": "punctuation.separator.table.spp" }]
    },
    "step": {
      "begin": "(?:^|\\G)\\s*(Given|When|Then|And|But|\\*)\\s",
      "end": "$|(?<!\\\\)(?=`)",
      "beginCaptures": { "1": { "name": "keyword.other.step.spp" } },
      "patterns": [{ "include": "#code" }]
    },
    "defineBlock": {
      "begin": "(?:^|\\G)(\\s*)(Define)(?=:)",
      "while": "(?:^|\\G)(?=\\1\\s+\\S|\\s*$)",
      "beginCaptures": { "2": { "name": "keyword.other.spp" } },
      "patterns": [{ "include": "#comment" }, { "include": "#code" }]
    },
    "code": {
      "patterns": [{ "include": "#string" }, { "include": "#symbol" }, { "include": "#number" }, { "include": "#word" }]
    },
    "word": {
      "match": "(?<![\\w'\\-?!+/*>=<^.])[A-Z](?:[A-Za-z0-9\\-?!'+/*>=<^.]*[A-Za-z0-9\\-?!'+/*>=<^])?",
      "name": "entity.name.function.spp"
    },
    "number": {
      "match": "(?<![\\w.])-?(?:[1-9][0-9]*|[0-9])(?:\\.[0-9]+)?(?:e-?[0-9]+)?(?![\\w.])",
      "name": "constant.numeric.spp"
    },
    "symbol": {
      "match": "\\\\[A-Za-z0-9\\-?!'+/*>=<^.]+",
      "name": "string.other.symbol.spp"
    },
    "define": {
      "match": "\\bDefine\\b",
      "name": "keyword.other.spp"
    },
    "string": {
      "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
      "name": "string.quoted.double.spp"
    }
  }
}
