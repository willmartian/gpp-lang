{
  "name": "gpp-vscode",
  "displayName": "Gherkin++",
  "description": "Specs that run. Written by agents, read by people. Checking, hover, completion and highlighting for Gherkin++, in .gpp files, Markdown, and gpp`…` templates, Storybook play functions, in JavaScript and TypeScript.",
  "version": "0.1.0",
  "publisher": "gpp-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willmartian/gpp-lang.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.gpp",
    "workspaceContains:**/*.stories.{js,jsx,ts,tsx,mjs}"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, Gherkin++ uses the language server it ships with, never the workspace's, and doesn't load the workspace's gpp.config.ts, so it only shows files that don't parse."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "gpp",
        "aliases": [
          "gpp"
        ],
        "extensions": [
          ".gpp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gpp",
        "scopeName": "source.gpp",
        "path": "./syntaxes/gpp.tmLanguage.json"
      },
      {
        "scopeName": "markdown.gpp.codeblock",
        "path": "./syntaxes/gpp.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.gpp": "gpp"
        }
      },
      {
        "scopeName": "inline.gpp.template",
        "path": "./syntaxes/gpp.template.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.gpp": "gpp"
        }
      }
    ],
    "configuration": {
      "title": "Gherkin++",
      "properties": {
        "gpp.path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "The gpp-lang whose language server to use: a path to its bin/gpp-lang.js, relative to the workspace folder. Empty uses the workspace's node_modules/gpp-lang, or else the one this extension ships with."
        },
        "gpp.node": {
          "type": "string",
          "default": "node",
          "scope": "resource",
          "description": "The Node.js to run the workspace's gpp-lang language server with: a command, or a path relative to the workspace folder, like a script that sets up the environment first."
        }
      }
    },
    "configurationDefaults": {
      "[gpp]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node test/run.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run build"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "gpp-lang": "workspace:*",
    "typescript": "^7.0.2"
  },
  "private": true
}
